#!/usr/bin/env bash
# Managed by Ansible (apc-homelab).
# Local commit of the vault, no network and no GitHub key. The admin user pushes weekly.
set -euo pipefail
cd "{{ vault_root }}"
git add -A
if ! git diff --cached --quiet; then
  git -c user.name="apc-agent" -c user.email="agent@{{ host_short }}.local" \
    commit -qm "snapshot $(date +%F-%H%M)"
fi
